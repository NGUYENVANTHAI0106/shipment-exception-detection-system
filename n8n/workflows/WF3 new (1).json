    {
      "parameters": {
        "jsCode": "const webhook = $('WF3 Webhook').item.json || {};\nconst bodyFromWebhook = webhook.body && typeof webhook.body === 'object' ? webhook.body : {};\nconst bodyFromCurrent = $json.body && typeof $json.body === 'object' ? $json.body : {};\n\n// Prefer request body only (avoid mixing with headers/params metadata).\nconst payload = { ...bodyFromWebhook, ...bodyFromCurrent };\n\nconst rawExceptionId = payload.exception_id ?? payload.id ?? payload.exceptionId ?? webhook.query?.exception_id ?? webhook.params?.exception_id;\nconst exceptionId = typeof rawExceptionId === 'string' ? rawExceptionId.trim() : rawExceptionId;\nconst overdue = Number(payload.overdue_hours ?? payload.overdueHours ?? 0);\nlet severity = payload.severity;\nlet escalateToManager = Boolean(payload.escalate_to_manager);\nlet slaEscalationApplied = false;\n\nif (severity === 'HIGH' && overdue > 72) {\n  severity = 'CRITICAL';\n  escalateToManager = true;\n  slaEscalationApplied = true;\n}\nif (severity === 'MEDIUM' && overdue > 48) {\n  severity = 'HIGH';\n  slaEscalationApplied = true;\n}\n\nreturn [{\n  json: {\n    ...payload,\n    exception_id: exceptionId || null,\n    missing_exception_id: !exceptionId,\n    severity,\n    escalate_to_manager: escalateToManager,\n    overdue_hours: overdue,\n    sla_escalation_applied: slaEscalationApplied\n  }\n}];"
      },
      "id": "2e4ea0fe-e5c9-44c6-893f-d3f8e5f2a0f3",
      "name": "Apply SLA Escalation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT status, notified_at\nFROM exceptions\nWHERE id = $1\nUNION ALL\nSELECT 'open'::text AS status, NULL::timestamptz AS notified_at\nWHERE NOT EXISTS (SELECT 1 FROM exceptions WHERE id = $1)\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{[$json.exception_id]}}"
        }
      },
      "id": "0d296399-efa3-4514-8cdc-d6ed0b48fd6d",
